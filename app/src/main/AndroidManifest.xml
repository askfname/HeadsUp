<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 身体活动：步行 / 跑步 / 上下楼检测 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 位置（可选） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 前台服务 + 开机恢复 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 弹窗提醒悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 厂商管家页跳转所需：EMUI 自 2021 起要求声明，否则直接 SecurityException -->
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />
    <uses-permission android:name="com.hihonor.permission.external_app_settings.USE_COMPONENT" />
    <!-- ColorOS 显式跳转要求声明，否则抛 SecurityException -->
    <uses-permission android:name="oppo.permission.OPPO_COMPONENT_SAFE" />

    <!-- Android 11+ 包可见性：自启动/后台页需 resolve 校验 -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.honor.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.vivo.abe" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.samsung.android.sm_cn" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.letv.android.letvsafe" />
        <package android:name="com.zui.safecenter" />
        <package android:name="com.evenwell.powersaving.g3" />
        <package android:name="com.htc.pitroad" />
        <package android:name="com.zte.heartyservice" />
        <package android:name="com.sonymobile.cta" />
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.itel.autobootmanager" />
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".HeadsUpApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HeadsUp"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">

        <activity
            android:name=".reminder.ReminderActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.HeadsUp" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 步行检测前台服务；室内判断运行时按需附加 location 类型 -->
        <service
            android:name=".service.HeadsUpService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <!-- GMS 活动识别回调与通知操作 -->
        <receiver
            android:name=".service.ActivityUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.playlab.headsup.action.ACTIVITY_UPDATE" />
                <action android:name="com.playlab.headsup.action.DISMISS" />
            </intent-filter>
        </receiver>

        <!-- 开机或更新后恢复用户已开启的监测 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
