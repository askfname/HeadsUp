    <string name="indoor_help_title">Tentang fitur ini</string>
    <string name="indoor_help_desc">Fitur “Bisukan di dalam ruangan” terbatas oleh perangkat keras GPS dan lingkungan, sehingga mungkin tidak menentukan dalam/luar ruangan dengan benar. Jika perlu, sesuaikan parameter secara manual di Setelan lanjutan:</string>
